{
  "name": "blueprint-erp",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prepare-schema.js && prisma generate",
    "setup": "npx prisma db push && npx tsx prisma/seed.ts",
    "dev": "next dev -p 3000 --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "test": "npx cross-env NODE_OPTIONS='--experimental-vm-modules' jest --config jest.config.ts",
    "test:watch": "npx cross-env NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "npx cross-env NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:generate": "node scripts/prepare-schema.js && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset"
  },
