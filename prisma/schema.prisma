  slug             String    @unique
  logo             String?
  description      String?
  website          String?
  phone            String?
  email            String?
  address          String?
  taxNumber        String?
  currency         String    @default("AED")
  timezone         String    @default("Asia/Dubai")
  locale           String    @default("ar")
  isActive         Boolean   @default(true)
  planId           String? // Current plan ID
  stripeCustomerId String?
  deletedAt        DateTime? // Soft delete
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  plan                       Plan?                        @relation(fields: [planId], references: [id], onDelete: SetNull)
  users                      User[]
  subscriptions              Subscription[]
  projects                   Project[]
  tasks                      Task[]
  invoices                   Invoice[]
  clients                    Client[]
  payments                   Payment[]
  budgets                    Budget[]
  proposals                  Proposal[]
  contracts                  Contract[]
  bids                       Bid[]
  defects                    Defect[]
  risks                      Risk[]
  documents                  Document[]
  meetings                   Meeting[]
  buildingInspections        BuildingInspection[]
  purchaseOrders             PurchaseOrder[]
  tenders                    Tender[]
  siteVisits                 SiteVisit[]
  schedulePhases             SchedulePhase[]
  contractors                Contractor[]
  equipment                  Equipment[]
  // --- New multi-tenant relations (organizationId added) ---
  companySettings            CompanySettings[]
  municipalityCorrespondence MunicipalityCorrespondence[]
  projectStages              ProjectStage[]
  municipalRejections        MunicipalRejection[]
  govApprovals               GovApproval[]
  clientInteractions         ClientInteraction[]
  siteDiaries                SiteDiary[]
  rfis                       RFI[]
  submittals                 Submittal[]
  changeOrders               ChangeOrder[]
  transmittals               Transmittal[]
  boqItems                   BOQItem[]
  employees                  Employee[]
  attendance                 Attendance[]
  leaves                     Leave[]
  suppliers                  Supplier[]
  inventoryItems             InventoryItem[]
  quoteRequests              QuoteRequest[]
  knowledgeArticles          KnowledgeArticle[]
  notifications              Notification[]
  activityLogs               ActivityLog[]
  approvals                  Approval[]
  designPhases               DesignPhase[]
  supervisionChecklists      SupervisionChecklist[]
  violations                 Violation[]
  commissions                Commission[]
  referrals                  Referral[]
  marketingCampaigns         MarketingCampaign[]
  workflowTemplates          WorkflowTemplate[]
  securityAuditLogs          SecurityAuditLog[]
  contractorEvaluations      ContractorEvaluation[]
  automations                Automation[]
  projectComments            ProjectComment[]
  projectAssignments         ProjectAssignment[]
  taskComments               TaskComment[]
  slaBreaches                SLABreach[]
  notificationSettings       NotificationSettings[]
  aiChatConversations        AIChatConversation[]
  featureFlags               FeatureFlag[]
  aiChatMessages             AIChatMessage[]
  projectWorkflows           ProjectWorkflow[]
  workflowStages             WorkflowStage[]
  workflowSteps              WorkflowStep[]
  riskActions                RiskAction[]
  workflowTemplateStages     WorkflowTemplateStage[]
  workflowTemplateSteps      WorkflowTemplateStep[]
  subscriptionPayments       SubscriptionPayment[]
  retainages                 Retainage[]
  guaranteeLetters           GuaranteeLetter[]
  progressClaims             ProgressClaim[]
  timesheets                 Timesheet[]
  contractAmendments         ContractAmendment[]
  dashboardPresets           DashboardPreset[]
  accounts                   Account[]
  journalEntries             JournalEntry[]
  leads                      Lead[]
  bankAccounts               BankAccount[]
  bankTransactions           BankTransaction[]
  whatsAppTemplates          WhatsAppTemplate[]
  whatsAppMessages           WhatsAppMessage[]
  opportunities              Opportunity[]
  crmActivities              CRMActivity[]

