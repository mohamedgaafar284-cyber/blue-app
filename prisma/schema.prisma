// ==================== PAYMENTS ====================

model Payment {
  id              String   @id @default(cuid())
  voucherNumber   String   @default("")
  projectId       String?
  invoiceId       String?
  amount          Decimal  @default(0)
  payMethod       String   @default("transfer") // cash, cheque, transfer, online
