// Subscription Plans
model Plan {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  nameAr          String? // Arabic name
  description     String?
  descriptionAr   String? // Arabic description
  price           Decimal              @default(0)
  currency        String               @default("AED")
  interval        SubscriptionInterval @default(MONTH)
  stripeProductId String?
  stripePriceId   String?
  features        String               @default("{}") // JSON string for features
  limits          String               @default("{}") // JSON string for limits
  isActive        Boolean              @default(true)
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  subscriptions Subscription[]
  organizations Organization[]
}

// Organization Subscriptions
model Subscription {
  id                    String             @id @default(cuid())
  organizationId        String
  planId                String
  status                SubscriptionStatus @default(ACTIVE)
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean            @default(false)
  stripeSubscriptionId  String?
  stripeCustomerId      String?
  stripePaymentIntentId String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptionPayments SubscriptionPayment[]

  @@unique([stripeSubscriptionId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([planId])
}

// Subscription Payments (SaaS)
model SubscriptionPayment {
  id                    String        @id @default(cuid())
  subscriptionId        String
  amount                Decimal       @default(0)
  currency              String        @default("AED")
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeInvoiceId       String?
  receiptUrl            String?
  description           String?
  metadata              String? // JSON string
  organizationId        String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([organizationId])
}

// Email Verification Token
model EmailVerificationToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  userId    String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

// Password Reset Token
model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  userId    String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

// Two-Factor Authentication Secret
model TwoFactorSecret {
  id          String    @id @default(cuid())
  userId      String    @unique
  secret      String // Encrypted TOTP secret
  backupCodes String // JSON string for backup codes
  isEnabled   Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Two-Factor Challenge
model TwoFactorChallenge {
  id        String                 @id @default(cuid())
  userId    String
  code      String
  type      TwoFactorChallengeType @default(TOTP)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([expiresAt])
}

// SLA Breach Tracking
model SLABreach {
  id              String          @id @default(cuid())
  taskId          String
  projectId       String?
  status          SLABreachStatus @default(WARNING)
  daysElapsed     Int             @default(0) // Days since SLA start
  slaDays         Int             @default(0) // Expected SLA days
  breachDays      Int             @default(0) // Days over SLA
  notifiedAt      DateTime? // When notification was sent
  notifiedUsers   String? // JSON array of user IDs notified
  resolvedAt      DateTime? // When breach was resolved
  resolutionNotes String?
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task            Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([taskId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
}

// User Notification Settings
model NotificationSettings {
  id                 String       @id @default(cuid())
  userId             String       @unique
  emailNotifications Boolean      @default(true)
  pushNotifications  Boolean      @default(true)
  taskAssigned       Boolean      @default(true)
  taskDueSoon        Boolean      @default(true)
  taskOverdue        Boolean      @default(true)
  invoiceOverdue     Boolean      @default(true)
  projectUpdates     Boolean      @default(true)
  slaWarnings        Boolean      @default(true)
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

// ==================== FEATURE FLAGS ====================

model FeatureFlag {
  id              String   @id @default(cuid())
  key             String
  name            String
  nameAr          String?
  description     String?
  descriptionAr   String?
  enabled         Boolean  @default(false)
  enabledForOrgs  String? // JSON array of organization IDs
  enabledForRoles String? // JSON array of roles
  percentage      Int      @default(100)
  organizationId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // SECURITY FIX: Changed from @unique on key alone (global) to @@unique([key, organizationId])
  // so multiple orgs can have flags with the same key. A null organizationId means
  // the flag is global (applies to all orgs).
  @@unique([key, organizationId])
  @@index([key])
  @@index([organizationId])
}

// ==================== AI CHAT PERSISTENCE ====================

/// AI Chat Conversation
model AIChatConversation {
  id             String       @id @default(cuid())
  userId         String
  title          String       @default("")
  projectId      String?
  lastMessageAt  DateTime     @default(now())
  messageCount   Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages AIChatMessage[]

  @@index([userId])
  @@index([projectId])
  @@index([lastMessageAt])
  @@index([organizationId])
}

/// AI Chat Message
model AIChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           String // 'user' | 'assistant' | 'system'
  content        String
  tokens         Int          @default(0)
  model          String       @default("")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  conversation AIChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([organizationId])
}

// ==================== SECURITY AUDIT LOG ====================

/// Security Audit Log for tracking sensitive operations
model SecurityAuditLog {
  id             String   @id @default(cuid())
  userId         String?
  action         String // login, logout, 2fa_enable, 2fa_disable, password_change, etc.
  entityType     String?
  entityId       String?
  ipAddress      String?
  userAgent      String?
  details        String? // JSON string for additional details
  status         String   @default("success") // success, failed, blocked
  errorMessage   String?
  organizationId String // SaaS multi-tenant organization
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("SecurityAuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
}

// ==================== AUTOMATIONS ====================

model Automation {
  id             String    @id @default(cuid())
  name           String    @default("")
  description    String    @default("")
  triggerType    String    @default("") // threshold, schedule, event
  triggerConfig  String    @default("") // JSON: {threshold, metric, cron, event, ...}
  actionType     String    @default("") // notification, email, task, webhook
  actionConfig   String    @default("") // JSON: {recipients, template, action, ...}
  status         String    @default("inactive") // active, inactive, paused
  lastRunAt      DateTime?
  runCount       Int       @default(0)
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deletedAt    DateTime? // Soft delete

  @@index([status])
  @@index([organizationId])
  @@index([deletedAt])
}

// ==================== RETAINAGE MANAGEMENT ====================

/// Retainage tracking for UAE construction projects (5-10% held until completion)
model Retainage {
  id             String    @id @default(cuid())
  organizationId String // SaaS multi-tenant organization
  projectId      String
  invoiceId      String? // Link to invoice that generated this retainage
  percentage     Decimal   @default(0) // Retainage percentage (e.g. 5, 10)
  retainedAmount Decimal   @default(0) // Amount retained
  releaseDate    DateTime? // Expected or actual release date
  status         String    @default("HELD") // HELD, PARTIALLY_RELEASED, RELEASED
  releasedAmount Decimal   @default(0) // Amount released so far
  releasedDate   DateTime? // Date of last release
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([organizationId])
}

// ==================== GUARANTEE LETTERS ====================

/// Bank guarantees for UAE construction (Performance, Advance Payment, Retention, Bid Bond)
model GuaranteeLetter {
  id              String    @id @default(cuid())
  organizationId  String // SaaS multi-tenant organization
  projectId       String
  type            String    @default("PERFORMANCE") // PERFORMANCE, ADVANCE_PAYMENT, RETENTION, BID_BOND
  guaranteeNumber String    @default("") // Bank guarantee reference number
  bankName        String    @default("")
  amount          Decimal   @default(0)
  currency        String    @default("AED")
  issueDate       DateTime?
  expiryDate      DateTime?
  status          String    @default("ACTIVE") // ACTIVE, EXPIRED, RELEASED, CLAIMED
  beneficiaryName String    @default("")
  documentUrl     String    @default("") // Link to uploaded guarantee document
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deletedAt    DateTime? // Soft delete

  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([organizationId])
  @@index([expiryDate])
  @@index([deletedAt])
}

// ==================== PROGRESS CLAIMS ====================

/// Monthly progress claims for UAE construction (Interim Payment Applications)
model ProgressClaim {
  id                String    @id @default(cuid())
  organizationId    String // SaaS multi-tenant organization
  projectId         String
  claimNumber       String    @default("") // e.g. "IPC-001"
  period            String    @default("") // e.g. "March 2025"
  claimDate         DateTime?
  totalClaimAmount  Decimal   @default(0)
  approvedAmount    Decimal   @default(0)
  previousCertified Decimal   @default(0) // Cumulative previously certified
  currentCertified  Decimal   @default(0) // Current certification amount
  retentionAmount   Decimal   @default(0) // Retention deducted
  netPayment        Decimal   @default(0) // currentCertified - retentionAmount
  status            String    @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED
  certifiedDate     DateTime?
  certifiedById     String? // User who certified
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  certifiedBy  User?        @relation("ProgressClaimCertifier", fields: [certifiedById], references: [id], onDelete: SetNull)
  deletedAt    DateTime? // Soft delete

  @@index([projectId])
  @@index([status])
  @@index([organizationId])
  @@index([claimNumber])
  @@index([deletedAt])
}

// ==================== TIMESHEETS ====================

model Timesheet {
  id             String    @id @default(cuid())
  employeeId     String
  projectId      String?
  weekStart      DateTime
  weekEnd        DateTime
  status         String    @default("DRAFT")
  totalHours     Float     @default(0)
  notes          String    @default("")
  rejectedReason String?
  approvedById   String?
  approvedAt     DateTime?
  submittedAt    DateTime?
  organizationId String
  deletedAt      DateTime? // Soft delete
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approvedBy   User?            @relation("TimesheetApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      TimesheetEntry[]

  @@unique([employeeId, weekStart])
  @@index([employeeId])
  @@index([projectId])
  @@index([approvedById])
  @@index([organizationId])
  @@index([weekStart])
  @@index([status])
  @@index([deletedAt])
}

model TimesheetEntry {
  id          String   @id @default(cuid())
  timesheetId String
  date        DateTime
  hours       Float    @default(0)
  taskType    String   @default("STANDARD")
  description String   @default("")
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([timesheetId])
  @@index([projectId])
}

// Push Notification Subscriptions
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Dashboard Presets for role-specific dashboard layouts
model DashboardPreset {
  id             String   @id @default(cuid())
  name           String
  nameEn         String
  role           UserRole
  isDefault      Boolean  @default(false)
  isSystem       Boolean  @default(false) // System presets are shared across all orgs
  layout         String   @default("[]") // JSON string layout
  widgets        String   @default("[]") // JSON string widgets
  organizationId String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([organizationId])
  @@index([createdById])
  @@index([isSystem])
}

// Sequence numbering generator (idempotent document sequences)
model Sequence {
  id             String   @id @default(cuid())
  name           String
  value          Int      @default(0)
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // SECURITY FIX: organizationId is now nullable (was @default("")).
  // Null means global sequence; non-null means org-specific.
  // The @@unique constraint still works with nulls (each null is treated
  // as distinct in Postgres, but Prisma handles this correctly).
  @@unique([name, organizationId])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id              String      @id @default(cuid())
  code            String
  nameAr          String
  nameEn          String
  description     String?
  type            AccountType
  parentAccountId String?
  organizationId  String
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentAccount Account?      @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: Cascade)
  childAccounts Account[]     @relation("AccountHierarchy")
  journalLines  JournalLine[]
  bankAccounts  BankAccount[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentAccountId])
}

model JournalEntry {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  reference      String? // e.g. Invoice Number, Receipt Number
  description    String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines            JournalLine[]
  bankTransactions BankTransaction[]

  @@index([organizationId])
  @@index([date])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal  @default(0)
  credit         Decimal  @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountId])
}

model Lead {
  id             String    @id @default(cuid())
  name           String    @default("")
  company        String?   @default("")
  email          String?   @default("")
  phone          String?   @default("")
  status         String    @default("NEW") // NEW, CONTACTED, PROPOSAL_SENT, WON, LOST
  estimatedValue Decimal   @default(0)
  notes          String?   @default("")
  organizationId String
  deletedAt      DateTime? // Soft delete
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  activities    CRMActivity[]

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@map("leads")
}

// ==================== BANK ACCOUNTS & RECONCILIATION ====================

model BankAccount {
  id             String   @id @default(cuid())
  name           String // e.g. "ADCB Current Account"
  nameAr         String? // e.g. "حساب ADCB الجاري"
  bankName       String // e.g. "ADCB", "Emirates NBD"
  iban           String?  @unique // International Bank Account Number
  accountNumber  String? // Last 4 digits for display
  currency       String   @default("AED")
  accountId      String? // Link to Chart of Accounts (GL account 1020)
  organizationId String
  isActive       Boolean  @default(true)
  openingBalance Decimal  @default(0)
  currentBalance Decimal  @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactions BankTransaction[]

  @@index([organizationId])
  @@index([isActive])
}

model BankTransaction {
  id             String    @id @default(cuid())
  bankAccountId  String
  date           DateTime
  description    String
  reference      String? // Cheque number, transfer ref, etc.
  amount         Decimal // Positive = deposit, Negative = withdrawal
  balanceAfter   Decimal // Running balance after this transaction
  type           String    @default("OTHER") // DEPOSIT, WITHDRAWAL, TRANSFER, FEE, INTEREST, OTHER
  isReconciled   Boolean   @default(false)
  reconciledAt   DateTime?
  journalEntryId String? // Link to GL journal entry if matched
  matchType      String? // "AUTO" or "MANUAL" or null
  matchDetails   String? // JSON string: what was matched (invoice, payment, etc.)
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([bankAccountId])
  @@index([organizationId])
  @@index([date])
  @@index([isReconciled])
}

// Add relations to existing models
// Relations added to Organization, Account, JournalEntry

// ==================== WHATSAPP INTEGRATION ====================

model WhatsAppTemplate {
  id             String   @id @default(cuid())
  name           String // Template name (unique per org)
  language       String   @default("ar") // ar, en
  category       String   @default("MARKETING") // MARKETING, UTILITY, AUTHENTICATION
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  headerType     String? // TEXT, IMAGE, DOCUMENT, VIDEO
  headerText     String?
  bodyText       String // Template body with {{1}}, {{2}} placeholders
  footerText     String?
  buttonType     String? // NONE, QUICK_REPLY, CALL_TO_ACTION
  buttons        String? // JSON string of buttons
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     WhatsAppMessage[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([status])
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  to             String // Phone number (with country code)
  from           String? // Sender phone number (WhatsApp Business number)
  messageText    String? // Text content
  templateId     String? // If sent via template
  templateParams String? // JSON string of template parameters
  status         String   @default("QUEUED") // QUEUED, SENT, DELIVERED, READ, FAILED
  direction      String   @default("OUTBOUND") // OUTBOUND, INBOUND
  errorMessage   String?
  invoiceId      String? // If linked to an invoice
  clientId       String? // If linked to a client
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     WhatsAppTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
  @@index([to])
  @@index([invoiceId])
  @@index([createdAt])
}

// ==================== CRM: OPPORTUNITIES & ACTIVITIES ====================

model Opportunity {
  id                String    @id @default(cuid())
  title             String
  leadId            String? // Link to Lead (if originated from a lead)
  clientId          String? // Link to Client (if converted)
  projectId         String? // Link to Project (if won and project created)
  stage             String    @default("QUALIFICATION") // QUALIFICATION, NEEDS_ANALYSIS, PROPOSAL, NEGOTIATION, WON, LOST
  probability       Int       @default(10) // 0-100
  estimatedValue    Decimal   @default(0)
  expectedCloseDate DateTime?
  description       String?
  lostReason        String?
  organizationId    String
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities   CRMActivity[]

  @@index([organizationId])
  @@index([stage])
  @@index([leadId])
  @@index([deletedAt])
}

model CRMActivity {
  id             String    @id @default(cuid())
  type           String // CALL, MEETING, EMAIL, TASK, NOTE, WHATSAPP
  title          String
  description    String?
  dueDate        DateTime?
  completedAt    DateTime?
  status         String    @default("PENDING") // PENDING, COMPLETED, CANCELLED
  leadId         String?
  opportunityId  String?
  clientId       String?
  assignedToId   String? // User ID
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([status])
  @@index([dueDate])
}
