// ============================================
// DATABASE PROVIDER CONFIGURATION
// ============================================
// This schema is configured for SQLite.
//
// SETUP:
//   1. Set DATABASE_URL in .env to "file:./db/custom.db"
//   2. Run: npx prisma db push
//   3. Run: npx tsx prisma/seed.ts
//
// NOTE: With SQLite, enums are stored as strings.
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS (SaaS Multi-tenant) ====================

/// User roles in the system
enum UserRole {
  ADMIN // Full system access
  MANAGER // Project management access
  PROJECT_MANAGER // Project-level management
  ENGINEER // Technical access
  DRAFTSMAN // Drafting and drawing access
  ACCOUNTANT // Financial access
  HR // Human resources access
  SECRETARY // Office management and documents
  VIEWER // Read-only access
}

/// Permission types for fine-grained access control
enum Permission {
  // Project permissions
  PROJECT_CREATE
  PROJECT_READ
  PROJECT_UPDATE
  PROJECT_DELETE

  // Task permissions
  TASK_CREATE
  TASK_READ
  TASK_UPDATE
  TASK_DELETE

  // Client permissions
  CLIENT_CREATE
  CLIENT_READ
  CLIENT_UPDATE
  CLIENT_DELETE

  // Invoice permissions
  INVOICE_CREATE
  INVOICE_READ
  INVOICE_UPDATE
  INVOICE_DELETE

  // User management permissions
  USER_CREATE
  USER_READ
  USER_UPDATE
  USER_DELETE

  // Settings permissions
  SETTINGS_READ
  SETTINGS_UPDATE

  // Reports permissions
  REPORTS_READ
  REPORTS_EXPORT

  // Budget permissions
  BUDGET_MANAGE

  // Document permissions
  DOCUMENT_CREATE
  DOCUMENT_READ
  DOCUMENT_UPDATE
  DOCUMENT_DELETE
}

/// Subscription status
enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

/// Payment status for SaaS subscriptions
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// Subscription interval
enum SubscriptionInterval {
  MONTH
  YEAR
}

/// Two-factor challenge type
enum TwoFactorChallengeType {
  TOTP
  BACKUP
  SMS
}

/// Task type for categorization
enum TaskType {
  STANDARD // Regular task
  GOVERNMENTAL // Government entity
  MANDATORY // Mandatory for licensing
  CLIENT // Client approval
  INTERNAL // Internal task
}

/// SLA breach status for monitoring
enum SLABreachStatus {
  WARNING // Warning before SLA expires
  BREACHED // SLA exceeded
  CRITICAL // Critical breach
  RESOLVED // Resolved
}

/// Government approval status
enum GovernmentApprovalStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

/// Utility connection status
enum UtilityConnectionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ==================== USERS & AUTH ====================

model User {
  id                  String    @id @default(cuid())
  email               String
  password            String    @default("") // Auth service always hashes passwords before saving; empty default prevents accidental login
  name                String    @default("")
  phone               String    @default("")
  avatar              String    @default("")
  role                UserRole  @default(VIEWER)
  department          String    @default("")
  position            String    @default("")
  isActive            Boolean   @default(true)
  lastLogin           DateTime?
  organizationId      String? // SaaS multi-tenant organization
  deletedAt           DateTime? // Soft delete
  // Email verification
  emailVerified       DateTime?
  // NOTE: verifyToken and verifyTokenExpiry fields were removed.
  // Email verification now uses the separate EmailVerificationToken model
  // which stores hashed tokens — never plaintext.
  // Password reset uses the separate PasswordResetToken model.
  passwordChangedAt   DateTime? // When password was last changed - used to invalidate tokens
  // 2FA — the User model's twoFactorEnabled field is kept for quick lookups.
  // The actual secret and backup codes are stored in the TwoFactorSecret model.
  twoFactorEnabled    Boolean   @default(false)
  // NOTE: twoFactorSecret and backupCodes fields were removed from User model.
  // They are now stored exclusively in the TwoFactorSecret model where
  // the secret is AES-256-GCM encrypted and backup codes are SHA-256 hashed.
  // Account lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  preferences         String?   @default("{}")
  googleId            String? // Google OAuth sub ID — for social login
  microsoftId         String? // Microsoft OAuth sub ID — for social login
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization            Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dashboardPresets        DashboardPreset[]
  projects                ProjectAssignment[]
  tasks                   Task[]
  assignedDefects         Defect[]
  assignedWorkflowStages  WorkflowStage[]          @relation("WorkflowStageAssignee")
  assignedWorkflowSteps   WorkflowStep[]           @relation("WorkflowStepAssignee")
  activities              ActivityLog[]
  leaves                  Leave[]
  createdProjects         Project[]                @relation("CreatedProjects")
  managedProjects         Project[]                @relation("ProjectManager")
  rfisFrom                RFI[]                    @relation("RFIFrom")
  rfisTo                  RFI[]                    @relation("RFITo")
  riskActions             RiskAction[]
  meetingAttendee         MeetingAttendee[]
  notifications           Notification[]
  sentTransmittals        Transmittal[]            @relation("TransmittalFrom")
  knowledgeArticles       KnowledgeArticle[]
  employee                Employee?
  approvedPayments        Payment[]                @relation("PaymentApprover")
  approvedLeaves          Leave[]                  @relation("LeaveApprover")
  approvedTimesheets      Timesheet[]              @relation("TimesheetApprover")
  uploadedDocuments       Document[]               @relation("DocumentUploader")
  projectComments         ProjectComment[]
  comments                TaskComment[]
  tenders                 Tender[]                 @relation("TenderAssignee")
  commissions             Commission[]             @relation("CommissionUser")
  approvedCommissions     Commission[]             @relation("CommissionApprover")
  referrals               Referral[]               @relation("ReferralReferrer")
  notificationSettings    NotificationSettings?
  aiChatConversations     AIChatConversation[]
  refreshTokens           RefreshToken[]
  paymentCreated          Payment[]                @relation("PaymentCreator")
  paymentUpdated          Payment[]                @relation("PaymentUpdater")
  budgetCreated           Budget[]                 @relation("BudgetCreator")
  budgetUpdated           Budget[]                 @relation("BudgetUpdater")
  proposalCreated         Proposal[]               @relation("ProposalCreator")
  proposalUpdated         Proposal[]               @relation("ProposalUpdater")
  invoicePayments         InvoicePayment[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  twoFactorSecret         TwoFactorSecret?
  twoFactorChallenges     TwoFactorChallenge[]
  pushSubscriptions       PushSubscription[]
  designPhases            DesignPhase[]            @relation("DesignPhaseDesigner")
  projectStages           ProjectStage[]           @relation("ProjectStageEngineer")
  supervisionChecklists   SupervisionChecklist[]   @relation("SupervisionChecklistEngineer")
  approvedChecklists      SupervisionChecklist[]   @relation("SupervisionChecklistApprover")
  designDrawings          DesignDrawing[]          @relation("DesignDrawingUploader")
  designRevisions         DesignRevision[]         @relation("DesignRevisionUploader")
  certifiedProgressClaims ProgressClaim[]          @relation("ProgressClaimCertifier")
  securityAuditLogs       SecurityAuditLog[]       @relation("SecurityAuditLogUser")
  crmActivities           CRMActivity[]

  @@unique([email, organizationId])
  @@unique([googleId, organizationId])
  @@unique([microsoftId, organizationId])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([name])
  @@index([role])
  @@index([isActive])
}

// ==================== REFRESH TOKENS ====================

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 hash of the token
  expiresAt DateTime
  revokedAt DateTime? // When token was explicitly revoked
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// ==================== COMPANY SETTINGS ====================

model CompanySettings {
  id             String   @id @default(cuid())
  name           String   @default("مكتب الاستشارات الهندسية")
  nameEn         String   @default("Engineering Consultancy Office")
  logo           String   @default("")
  email          String   @default("")
  phone          String   @default("")
  address        String   @default("")
  taxNumber      String   @default("")
  currency       String   @default("AED")
  timezone       String   @default("Asia/Dubai")
  workingDays    String   @default("sat,sun,mon,tue,wed,thu") // comma-separated UAE work week (Saturday-Thursday)
  workingHours   String   @default("08:00-17:00")
  organizationId String // SaaS multi-tenant organization
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ==================== PROJECTS ====================

model Project {
  id                    String    @id @default(cuid())
  number                String
  name                  String    @default("")
  nameEn                String    @default("")
  clientId              String
  contractorId          String?
  location              String    @default("")
  latitude              Float?
  longitude             Float?
  plotNumber            String    @default("")
  type                  String    @default("villa") // villa, building, commercial, industrial
  status                String    @default("active") // active, completed, delayed, on_hold, cancelled
  progress              Float     @default(0)
  budget                Decimal   @default(0)
  contractValue         Decimal   @default(0) // Total contract value
  paymentMethod         String    @default("") // cash, cheque, transfer, installments
  paymentSchedule       String    @default("") // JSON: [{milestone,amount,percentage,dueDate,status}]
  expectedDuration      Int       @default(0) // Expected duration in days
  startDate             DateTime?
  endDate               DateTime?
  expectedEndDate       DateTime? // Expected delivery date
  actualStartDate       DateTime?
  actualEndDate         DateTime?
  contractDate          DateTime?
  description           String    @default("")
  municipalityChecklist String    @default("") // JSON: [{id,label,checked,stage}]
  managerId             String?
  createdById           String?
  organizationId        String // SaaS multi-tenant organization
  deletedAt             DateTime? // Soft delete
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  client                     Client                       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contractor                 Contractor?                  @relation("ProjectContractor", fields: [contractorId], references: [id], onDelete: SetNull)
  createdBy                  User?                        @relation("CreatedProjects", fields: [createdById], references: [id], onDelete: SetNull)
  manager                    User?                        @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  organization               Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments                ProjectAssignment[]
  tasks                      Task[]
  stages                     ProjectStage[]
  muniRejections             MunicipalRejection[]
  govApprovals               GovApproval[]
  boqItems                   BOQItem[]
  schedulePhases             SchedulePhase[]
  invoices                   Invoice[]
  contracts                  Contract[]
  proposals                  Proposal[]
  bids                       Bid[]
  budgets                    Budget[]
  commissions                Commission[]
  referrals                  Referral[]
  siteVisits                 SiteVisit[]
  defects                    Defect[]
  siteDiaries                SiteDiary[]
  rfis                       RFI[]
  submittals                 Submittal[]
  changeOrders               ChangeOrder[]
  transmittals               Transmittal[]
  risks                      Risk[]
  meetings                   Meeting[]
  clientInteractions         ClientInteraction[]
  documents                  Document[]
  purchaseOrders             PurchaseOrder[]
  inventoryItems             InventoryItem[]
  payments                   Payment[]
  comments                   ProjectComment[]
  municipalityCorrespondence MunicipalityCorrespondence[]
  approvals                  Approval[]
  notifications              Notification[]
  activityLogs               ActivityLog[]
  knowledgeArticles          KnowledgeArticle[]
  designPhases               DesignPhase[]
  buildingInspections        BuildingInspection[]
  supervisionChecklists      SupervisionChecklist[]
  violations                 Violation[]
  workflow                   ProjectWorkflow?
  retainages                 Retainage[]
  guaranteeLetters           GuaranteeLetter[]
  progressClaims             ProgressClaim[]
  timesheets                 Timesheet[]
  timesheetEntries           TimesheetEntry[]
  contractorEvaluations      ContractorEvaluation[]
  slaBreaches                SLABreach[]
  aiChatConversations        AIChatConversation[]

  @@unique([number, organizationId])
  @@index([clientId])
  @@index([status])
  @@index([contractorId])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([createdById])
  @@index([managerId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status, deletedAt])
}

// ==================== MUNICIPALITY CORRESPONDENCE ====================

model MunicipalityCorrespondence {
  id                 String    @id @default(cuid())
  projectId          String
  referenceNumber    String    @default("")
  municipality       String    @default("")
  correspondenceType String    @default("SUBMISSION") // SUBMISSION, RESPONSE, REJECTION, APPROVAL, INQUIRY, AMENDMENT
  subject            String    @default("")
  content            String    @default("")
  submissionDate     DateTime?
  responseDate       DateTime?
  status             String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, AMENDMENT_REQUIRED
  notes              String    @default("")
  responseNotes      String    @default("")
  organizationId     String // SaaS multi-tenant organization
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deletedAt    DateTime? // Soft delete

  @@index([projectId])
  @@index([status])
  @@index([organizationId])
  @@index([deletedAt])
}

model ProjectComment {
  id             String       @id @default(cuid())
  content        String
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime? // Soft delete

  @@index([userId])
  @@index([projectId])
  @@index([organizationId])
  @@index([deletedAt])
}

model ProjectAssignment {
  id             String       @id @default(cuid())
  projectId      String
  userId         String
  role           String       @default("team_member")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt DateTime? // Soft delete

  @@unique([projectId, userId])
  @@index([organizationId])
  @@index([deletedAt])
}

// ==================== PROJECT STAGES ====================

model ProjectStage {
  id             String   @id @default(cuid())
  projectId      String
  department     String // architectural, structural, mep_electrical, mep_plumbing, mep_water, mep_civil_defense, mep_telecom
  stageName      String   @default("")
  stageOrder     Int      @default(0)
  status         String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, SUBMITTED, APPROVED, REJECTED
  engineerId     String?
  notes          String   @default("")
  organizationId String // SaaS multi-tenant organization
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  engineer     User?        @relation("ProjectStageEngineer", fields: [engineerId], references: [id], onDelete: SetNull)

  @@index([projectId, department])
  @@index([status])
  @@index([organizationId])
}

model MunicipalRejection {
  id                String    @id @default(cuid())
  projectId         String
  department        String
  count             Int       @default(0)
  notes             String    @default("")
  lastRejectionDate DateTime?
  organizationId    String // SaaS multi-tenant organization
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, department])
  @@index([organizationId])
}

// ==================== GOVERNMENT APPROVALS ====================

model GovApproval {
  id             String                   @id @default(cuid())
  projectId      String
  authority      String // MUN, FEWA, ETISALAT, CIVIL_DEFENSE
  status         GovernmentApprovalStatus @default(PENDING)
  submissionDate DateTime?
  approvalDate   DateTime?
  rejectionCount Int                      @default(0)
  notes          String                   @default("")
  organizationId String // SaaS multi-tenant organization
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, authority])
  @@index([status])
  @@index([organizationId])
}

// ==================== CLIENTS ====================

model Client {
  id             String    @id @default(cuid())
  // Basic Info
  clientType     String    @default("individual") // individual, company, government
  name           String    @default("")
  nameEn         String    @default("")
  company        String    @default("")
  companyEn      String    @default("")
  idNumber       String    @default("") // UAE ID or Commercial Registration
  nationality    String    @default("")
  idPhoto        String    @default("") // ID photo file path
  email          String    @default("") // Email uniqueness enforced at application level (many clients may have empty email)
  phone          String    @default("")
  whatsapp       String    @default("") // separate WhatsApp number
  extraPhone     String    @default("") // additional phone
  address        String    @default("")
  fullAddress    String    @default("") // JSON: {emirate,city,area,street,building,unit}
  taxNumber      String    @default("")
  creditLimit    Decimal   @default(0)
  paymentTerms   String    @default("")
  // Services & Project Info
  servicesWanted String    @default("") // JSON array: ["consultation","design","license",...]
  projectType    String    @default("") // villa, apartment, commercial, industrial, residential_building, medical
  serviceNotes   String? // legacy: additional details
  // Land Details
  landLocation   String    @default("")
  landArea       String    @default("")
  plotNumber     String    @default("")
  planNumber     String    @default("")
  landDocuments  String    @default("") // JSON array: [{type:"survey",path:...},...]
  notes          String    @default("")
  // Referral
  referralSource String    @default("") // social_media, referral, website, walk_in, advertisement, other
  referralDetail String    @default("")
  // Credit & Status
  creditUsed     Decimal   @default(0)
  isActive       Boolean   @default(true)
  organizationId String // SaaS multi-tenant organization
  createdById    String?
  deletedAt      DateTime? // Soft delete
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  projects            Project[]
  invoices            Invoice[]
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contracts           Contract[]
  proposals           Proposal[]
  interactions        ClientInteraction[]
  buildingInspections BuildingInspection[]

  @@unique([email, organizationId], name: "client_email_org_unique")
  @@unique([idNumber, organizationId], name: "client_idnumber_org_unique")
  @@index([organizationId])
  @@index([email]) // Index for email lookups
  @@index([idNumber]) // Index for ID number lookups
  @@index([deletedAt])
  @@index([isActive])
  @@index([createdById])
  @@index([organizationId, deletedAt])
  @@index([organizationId, isActive, deletedAt])
}

model ClientInteraction {
  id             String   @id @default(cuid())
  projectId      String
  clientId       String
  type           String   @default("meeting") // meeting, call, email
  date           DateTime
  subject        String   @default("")
  description    String   @default("")
  outcome        String   @default("")
  organizationId String // SaaS multi-tenant organization
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([projectId])
  @@index([date])
  @@index([organizationId])
}

// ==================== TASKS ====================

model Task {
  id             String    @id @default(cuid())
  projectId      String?
  title          String    @default("")
  titleAr        String    @default("")
  description    String    @default("")
  assigneeId     String?
  priority       String    @default("normal") // normal, medium, high, urgent
  status         String    @default("todo") // todo, in_progress, review, done, cancelled
  startDate      DateTime?
  dueDate        DateTime?
  endDate        DateTime?
  progress       Float     @default(0)
  slaDays        Int?
  slaStartDate   DateTime?
  slaWarningDays Int       @default(3)
  slaBreachedAt  DateTime?
  taskType       TaskType  @default(STANDARD)
  dependencies   String? // JSON array of task IDs
  color          String    @default("")
  estimatedHours Float?
  actualHours    Float?
  isMilestone    Boolean   @default(false)
  order          Int       @default(0)
  organizationId String // SaaS multi-tenant organization
  createdById    String?
  deletedAt      DateTime? // Soft delete
  parentId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  subtasks     Task[]        @relation("TaskSubtask")
  parent       Task?         @relation("TaskSubtask", fields: [parentId], references: [id], onDelete: SetNull)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comments     TaskComment[]
  slaBreaches  SLABreach[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([organizationId])
  @@index([dueDate])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([status, dueDate])
  @@index([deletedAt])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status, deletedAt])
  @@index([createdById])
}

// ==================== TASK COMMENTS ====================

model TaskComment {
  id             String       @id @default(cuid())
  content        String
  taskId         String
  userId         String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deletedAt      DateTime? // Soft delete
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([organizationId])
  @@index([deletedAt])
}

// ==================== CONTRACTS ====================

model Contract {
  id             String    @id @default(cuid())
  number         String    @default("")
  title          String    @default("")
  clientId       String
  projectId      String
  value          Decimal   @default(0)
  type           String    @default("engineering_services") // engineering_services, construction, consulting, maintenance
  status         String    @default("draft") // draft, pending_signature, active, expired, completed
  signedByName   String    @default("")
  signedByTitle  String    @default("")
  signature      String    @default("")
  startDate      DateTime?
  deletedAt      DateTime? // Soft delete
  endDate        DateTime?
  organizationId String
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client       Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amendments   ContractAmendment[]
  documents    Document[]

  @@index([organizationId])
  @@index([projectId])
  @@index([clientId])
  @@index([deletedAt])
  @@index([status])
  @@index([createdById])
}

model ContractAmendment {
  id             String   @id @default(cuid())
  contractId     String
  organizationId String
  number         String   @default("")
  description    String   @default("")
  date           DateTime
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([organizationId])
  @@index([status])
}

// ==================== INVOICES ====================

model Invoice {
  id             String    @id @default(cuid())
  number         String    @default("")
  clientId       String
  projectId      String
  issueDate      DateTime
  dueDate        DateTime
  subtotal       Decimal   @default(0)
  tax            Decimal   @default(0)
  taxRate        Decimal   @default(0) // Tax percentage
  total          Decimal   @default(0)
  paidAmount     Decimal   @default(0)
  remaining      Decimal   @default(0)
  status         String    @default("draft") // draft, sent, partially_paid, paid, overdue, cancelled
  organizationId String // SaaS multi-tenant organization
  createdById    String?
  deletedAt      DateTime? // Soft delete
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  items           InvoiceItem[]
  invoicePayments InvoicePayment[]
  payments        Payment[]
  retainages      Retainage[]
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([number, organizationId], name: "invoice_number_org_unique")
  @@index([clientId])
  @@index([status])
  @@index([projectId])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([dueDate])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status, deletedAt])
  @@index([createdById])
}

model InvoiceItem {
  id          String   @id @default(cuid())
