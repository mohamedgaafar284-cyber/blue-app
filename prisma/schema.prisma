  autoComplete     Boolean  @default(false)
  onCompleteAction String   @default("next_step")
  daysToComplete   Int      @default(0)
  organizationId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stage         WorkflowTemplateStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  workflowSteps WorkflowStep[]
  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([stageId, order])
  @@index([organizationId])
}

model ProjectWorkflow {
  id             String       @id @default(cuid())
  projectId      String       @unique
  templateId     String?
  currentStageId String?
  status         String       @default("active")
  progress       Float        @default(0)
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // currentStageId is a FK reference to WorkflowStage but is not modeled as a Prisma relation
  // because multiple workflows can reference the same stage, creating a many-to-one that
  // conflicts with the one-to-many workflow→stages relation. The FK is maintained at the DB level.
  stages   WorkflowStage[]

  @@index([projectId])
  @@index([status])
  @@index([templateId])
  @@index([organizationId])
}

model WorkflowStage {
  id              String    @id @default(cuid())
  workflowId      String
  templateStageId String?
  name            String    @default("")
  nameEn          String    @default("")
  order           Int       @default(0)
  status          String    @default("pending")
  startDate       DateTime?
  dueDate         DateTime?
  completedDate   DateTime?
  assigneeId      String?
  notes           String    @default("")
  organizationId  String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignee      User?                  @relation("WorkflowStageAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  workflow      ProjectWorkflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  templateStage WorkflowTemplateStage? @relation(fields: [templateStageId], references: [id], onDelete: SetNull)
  steps         WorkflowStep[]
  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([workflowId, order])
  @@index([status])
  @@index([dueDate])
  @@index([assigneeId])
  @@index([organizationId])
}

model WorkflowStep {
  id             String    @id @default(cuid())
  stageId        String
  templateStepId String?
  name           String    @default("")
  nameEn         String    @default("")
  order          Int       @default(0)
  status         String    @default("locked")
  assigneeId     String?
  assignedRole   String    @default("")
  startDate      DateTime?
  dueDate        DateTime?
  completedDate  DateTime?
  action         String    @default("")
  notes          String    @default("")
  returnReason   String    @default("")
  severity       String    @default("normal")
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignee     User?                 @relation("WorkflowStepAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  stage        WorkflowStage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  templateStep WorkflowTemplateStep? @relation(fields: [templateStepId], references: [id], onDelete: SetNull)
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([stageId, order])
  @@index([status])
  @@index([dueDate])
  @@index([assigneeId])
  @@index([organizationId])
}

// ==================== SAAS MULTI-TENANT MODELS ====================

